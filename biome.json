{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "bracketSameLine": true,
      "arrowParentheses": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!.next/**",
      "!out/**",
      "!build/**",
      "!coverage/**",
      "!node_modules/**"
    ]
  }
}
